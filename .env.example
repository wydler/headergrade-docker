# Copy to .env and set values you need. Do not commit .env.
# Bind address on the Docker host. Use a LAN IP or 0.0.0.0 only when needed.
BIND_ADDRESS=127.0.0.1
HOST_PORT=3000

# HeaderGrade configuration (all optional)
# Use a long random value only if you use the bulk seeder.
SEED_TOKEN=
# Optional OWASP ZAP daemon integration
ZAP_API_URL=
ZAP_API_KEY=
